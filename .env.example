PORT=3000
HOST=127.0.0.1

# Required for sign up/sign in on every device.
# Use the shared MongoDB Atlas connection string for the same quickaid database.
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/quickaid?retryWrites=true&w=majority
MONGO_DB_NAME=quickaid

# Optional API keys for live maps/routing.
ONEMAP_TOKEN=
ORS_API_KEY=
LTA_ACCOUNT_KEY=

# Optional classroom domains for professional signup testing.
PROFESSIONAL_TEST_DOMAINS=quickaid.test

# Used by npm run seed for demo-account password recovery.
SEED_SECURITY_QUESTION=memorable_place
SEED_SECURITY_ANSWER=Singapore

# Optional demo volunteer used by npm run seed.
SEED_VOLUNTEER_EMAIL=volunteer@example.com
SEED_VOLUNTEER_PASSWORD=replace_with_a_strong_password
SEED_VOLUNTEER_NAME=Volunteer Demo User
